ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY wheels/ /opt/cove/wheels/
COPY requirements.lock /opt/cove/requirements.lock
RUN python -m pip install --no-index --find-links=/opt/cove/wheels \
      --require-hashes --only-binary=:all: --no-compile --no-cache-dir \
      --target /opt/cove/site -r /opt/cove/requirements.lock \
    && rm -rf /opt/cove/wheels
COPY application/ /opt/cove/application/
COPY environment.json /opt/cove/environment.json
COPY LICENSE /opt/cove/LICENSE
ENV PYTHONPATH=/opt/cove/application:/opt/cove/site PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /tmp
